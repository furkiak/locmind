{
  "name": "locmind",
  "version": "3.0.0",
  "description": "Locmind - a self-hosted 2D virtual universe with proximity voice, video, rooms, shared tools and mini games. Zero runtime dependencies.",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "author": "Furkan Akça",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkiak/locmind.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/run.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [
    "metaverse",
    "webrtc",
    "websocket",
    "spatial-audio",
    "canvas",
    "virtual-office",
    "self-hosted",
    "zero-dependency"
  ],
  "devDependencies": {
    "playwright-core": "^1.49.0"
  },
  "bin": {
    "locmind": "server.js"
  }
}
