# Copy to .env and start with:  node --env-file=.env server.js
# Every setting can also be a command line flag (--turn-public-ip 203.0.113.10) or live in locmind.json.
# Priority: flags > environment > locmind.json > defaults.

# ---------------------------------------------------------------- server
PORT=3000
HOST=0.0.0.0
SERVER_NAME=Locmind
# Optional: everybody needs this password to join (can also be set in the admin panel)
SERVER_PASSWORD=
MAX_PLAYERS=150
AFK_LIMIT_MINUTES=30
# Where secrets, bans, settings and permanent rooms are stored
DATA_DIR=./data
# Music library: put files in MEDIA_DIR/music, player uploads go to MEDIA_DIR/uploads
MEDIA_DIR=./media
ALLOW_UPLOADS=true
UPLOAD_MAX_MB=25
UPLOAD_QUOTA_MB=1024

# ------------------------------------------------------------ admin panel
# Leave empty to generate one on first start (printed once, stored in DATA_DIR/secrets.json)
ADMIN_TOKEN=

# ------------------------------------------------------------------ HTTPS
# Your own certificate (Let's Encrypt etc.), or a self-signed one for a LAN
TLS_CERT=
TLS_KEY=
TLS_SELF_SIGNED=false

# ------------------------------------------------- built-in STUN / TURN
TURN=true
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_PORTS=49160-49359
# Public IP of this machine (detected automatically when possible; set it behind NAT)
TURN_PUBLIC_IP=
# Host name clients use for the relay (defaults to the host the page was loaded from)
TURN_HOST=
# Leave empty to generate one (stored in DATA_DIR/secrets.json)
TURN_SECRET=
TURN_ALLOW_PRIVATE_PEERS=false
TURN_MAX_ALLOCATIONS_PER_IP=10
TURN_BANDWIDTH_KBPS=4000
# Use an external relay instead / in addition:
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=secret
# A full JSON array replaces every ICE server:
# ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]
# Add Google's public STUN server (talks to a third party, off by default)
EXTERNAL_STUN=false

# ---------------------------------------------------------- networking
# true / 1 behind one reverse proxy (nginx, Caddy, Traefik), or the number of proxies in front
TRUST_PROXY=false
# Other origins allowed to open a WebSocket (comma separated). Empty = same origin only.
CORS_ORIGIN=
MAX_CONNECTIONS_PER_IP=16

# ------------------------------------------- optional third-party music
# YouTube links and search in the music box (off by default: Locmind talks to nobody else)
YOUTUBE=false
INVIDIOUS_INSTANCES=https://yewtu.be,https://inv.nadeko.net,https://invidious.nerdvpn.de

# ---------------------------------------------------------- operations
LOG_LEVEL=info
# pretty | json (default: pretty on a terminal, json otherwise)
LOG_FORMAT=
# Prometheus metrics at /metrics (localhost or admin token only)
METRICS=true
