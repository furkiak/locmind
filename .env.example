# Copy to .env and start with:  node --env-file=.env server.js

# HTTP port / bind address
PORT=3000
HOST=0.0.0.0

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Traefik, ...)
TRUST_PROXY=0

# Comma separated list of origins allowed to open a socket from another site (empty = same origin only)
CORS_ORIGIN=

# Maximum number of simultaneous players
MAX_PLAYERS=150

# Minutes of inactivity before a player is disconnected
AFK_LIMIT_MINUTES=30

# WebRTC ICE servers. Default: public Google STUN servers.
# A full JSON array overrides everything:
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# ...or just add one TURN relay (recommended for production, needed behind symmetric NATs):
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Invidious instances used by the music box search box (comma separated).
# Pasting a YouTube link always works, even if every instance is down.
INVIDIOUS_INSTANCES=
